<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="backup_surface">#FFFFFF</color>
    <color name="backup_muted_surface">#F6F7F9</color>
    <color name="backup_text">#17191D</color>
    <color name="backup_secondary">#727781</color>
    <string name="backup_back">Back</string>
    <string name="backup_continue">Continue</string>
    <string name="backup_brand" translatable="false">Petal Backup</string>
    <string name="backup_provider_title">Choose a provider</string>
    <string name="backup_provider_description">Select where your backups are stored.</string>
    <style name="BackupPrimaryButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/backup_button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:padding">0dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
    <style name="BackupSecondaryButton" parent="BackupPrimaryButton">
        <item name="android:background">@drawable/backup_button_secondary</item>
        <item name="android:textColor">@color/backup_text</item>
    </style>
    <style name="BackupField" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/backup_field</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/backup_text</item>
        <item name="android:textColorHint">@color/backup_secondary</item>
    </style>
</resources>
