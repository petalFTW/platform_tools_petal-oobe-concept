<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/backup_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/backup_surface">
    <include layout="@layout/backup_brand" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="32dp" android:paddingTop="32dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="32sp" android:textColor="@color/backup_text" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/project_status" android:textSize="14sp" android:textColor="@color/backup_secondary" />
            <Button android:id="@+id/local_folder" style="@style/BackupSecondaryButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="32dp" android:text="@string/local_storage" />
            <TextView android:id="@+id/local_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/local_unset" android:textSize="13sp" android:textColor="@color/backup_secondary" />
            <Button android:id="@+id/cloud_provider" style="@style/BackupSecondaryButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="24dp" android:text="@string/cloud_storage" />
            <TextView android:id="@+id/cloud_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/cloud_unset" android:textSize="13sp" android:textColor="@color/backup_secondary" />
            <Button android:id="@+id/backup_action" style="@style/BackupSecondaryButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="24dp" android:enabled="false" android:text="@string/backup" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="32dp" android:paddingTop="12dp" android:paddingBottom="24dp">
        <Button android:id="@+id/skip_restore" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginBottom="12dp" android:text="@string/skip_restore" android:textColor="@color/backup_secondary" android:textSize="12sp" android:textAllCaps="false" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal">
            <Button android:id="@+id/backup_back" style="@style/BackupSecondaryButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="@string/backup_back" />
            <Button android:id="@+id/restore_action" style="@style/BackupPrimaryButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="6dp" android:enabled="false" android:alpha="0.4" android:text="@string/restore" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
