<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cloud_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/backup_surface">
    <include layout="@layout/backup_brand" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:id="@+id/cloud_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="32dp" android:paddingBottom="24dp">
        <TextView android:id="@+id/cloud_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textSize="28sp" android:textColor="?android:attr/textColorPrimary" />
        <TextView android:id="@+id/cloud_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/cloud_configure_info" />
        <LinearLayout android:id="@+id/cloud_connection_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
            <TextView android:id="@+id/cloud_endpoint_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_endpoint" android:labelFor="@id/cloud_endpoint" />
            <EditText android:id="@+id/cloud_endpoint" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:singleLine="true" android:hint="@string/cloud_endpoint_hint" />
            <LinearLayout android:id="@+id/webdav_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_folder" android:labelFor="@id/cloud_folder" />
                <EditText android:id="@+id/cloud_folder" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" android:text="/PetalBackup" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_username" android:labelFor="@id/cloud_username" />
                <EditText android:id="@+id/cloud_username" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_password" android:labelFor="@id/cloud_password" />
                <EditText android:id="@+id/cloud_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:singleLine="true" android:saveEnabled="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/s3_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_region" android:labelFor="@id/cloud_region" />
                <EditText android:id="@+id/cloud_region" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" android:text="us-east-1" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_bucket" android:labelFor="@id/cloud_bucket" />
                <EditText android:id="@+id/cloud_bucket" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_access_key" android:labelFor="@id/cloud_access_key" />
                <EditText android:id="@+id/cloud_access_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" android:saveEnabled="false" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_secret_key" android:labelFor="@id/cloud_secret_key" />
                <EditText android:id="@+id/cloud_secret_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:singleLine="true" android:saveEnabled="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/server_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_port" android:labelFor="@id/server_port" />
                <EditText android:id="@+id/server_port" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:singleLine="true" />
                <LinearLayout android:id="@+id/smb_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_share" android:labelFor="@id/server_share" />
                    <EditText android:id="@+id/server_share" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_domain" android:labelFor="@id/server_domain" />
                    <EditText android:id="@+id/server_domain" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" />
                </LinearLayout>
                <TextView android:id="@+id/server_folder_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_folder" android:labelFor="@id/server_folder" />
                <EditText android:id="@+id/server_folder" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_username" android:labelFor="@id/server_username" />
                <EditText android:id="@+id/server_username" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_password" android:labelFor="@id/server_password" />
                <EditText android:id="@+id/server_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:singleLine="true" android:saveEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="32dp" android:paddingTop="12dp" android:paddingBottom="24dp">
        <Button android:id="@+id/cloud_cancel" style="@style/BackupSecondaryButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="@string/backup_back" />
        <Button android:id="@+id/cloud_save" style="@style/BackupPrimaryButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/cloud_save" />
    </LinearLayout>
</LinearLayout>
