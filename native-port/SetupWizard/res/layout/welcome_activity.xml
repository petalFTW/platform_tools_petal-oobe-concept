<org.petal.setupwizard.PetalSetupLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/setup_wizard_layout" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="32dp">
        <Button android:id="@+id/launch_accessibility" style="@style/PetalTextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="end" android:text="@string/petal_accessibility" android:textSize="11sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/welcome_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/petal_hello" android:textSize="80sp" android:fontFamily="sans-serif-light" android:textColor="@color/petal_setup_text" android:accessibilityHeading="true" />
            <TextView android:id="@+id/welcome_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/petal_welcome" android:textSize="15sp" android:textColor="@color/petal_setup_text" />
            <Button android:id="@+id/welcome_language" style="@style/PetalTextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="24dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingBottom="36dp">
            <include layout="@layout/petal_wordmark" />
        </LinearLayout>
        <Button android:id="@+id/emerg_dialer" style="@style/PetalTextButton" android:layout_width="match_parent" android:layout_height="40dp" android:text="@string/emergency_call" />
        <Button android:id="@+id/skip" style="@style/PetalTextButton" android:layout_width="match_parent" android:layout_height="40dp" android:text="@string/skip" android:visibility="gone" />
        <Button android:id="@+id/start" style="@style/PetalPrimaryButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:layout_marginBottom="24dp" android:text="@string/start" />
    </LinearLayout>
</org.petal.setupwizard.PetalSetupLayout>
